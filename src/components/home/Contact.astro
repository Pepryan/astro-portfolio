---
/**
 * Closing contact band — the one inverted surface on the page.
 * One primary action (email), one quiet secondary link.
 */
import { componentConfig, seoConfig } from '../../config/components';
import { encodeEmail } from '../../lib/email';

interface Props {
  /** Section number on the homepage; omitted elsewhere */
  index?: string;
}

const { index } = Astro.props;
const { cta } = componentConfig;
---

<section class="contact" data-spotlight aria-labelledby="contact-title">
  <div class="ds-gridbg contact__bg" aria-hidden="true"></div>
  <p class="ds-eyebrow contact__eyebrow">
    {index && <span class="ds-index">{index}</span>}
    <span>Contact</span>
  </p>

  <div class="contact__grid">
    <h2 class="ds-h2" id="contact-title">{cta.title}</h2>
    <div class="contact__side">
      <p class="contact__text">{cta.subtitle}</p>
      <div class="contact__actions">
        <a class="ds-button" href={cta.primaryAction.link} data-email={cta.primaryAction.revealEmail ? encodeEmail(seoConfig.author.email) : undefined}>
          {cta.primaryAction.text} <span class="ds-arrow" aria-hidden="true">→</span>
        </a>
        <a class="ds-link" href={cta.secondaryAction.link}>
          {cta.secondaryAction.text} <span class="ds-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Closing band: follows the theme, bookends the hero with the same live grid */
  .contact {
    position: relative;
    isolation: isolate;
    max-width: var(--ds-container);
    margin: var(--ds-s16) auto 0;
    overflow: hidden;
    padding: var(--ds-s12) var(--ds-s6);
    border: var(--ds-hairline) solid var(--ds-rule);
    border-radius: var(--ds-radius);
    background: var(--ds-wash);
    color: var(--ds-ink);
  }

  .contact__bg {
    --gridbg-mask: radial-gradient(ellipse 70% 90% at 85% 50%, black 10%, transparent 70%);
  }

  .contact__eyebrow {
    margin-bottom: var(--ds-s8);
  }

  .contact__grid {
    display: grid;
    gap: var(--ds-s8);
  }

  .contact__text {
    max-width: var(--ds-measure);
    margin: 0;
    color: var(--ds-muted);
    font-size: var(--ds-fs-lede);
    line-height: var(--ds-lh-lede);
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ds-s4) var(--ds-s8);
    margin-top: var(--ds-s8);
  }

  /* Focus ring offset must match the band, not the page */
  .contact :focus-visible {
    --tw-ring-offset-color: var(--ds-wash);
  }

  @media (min-width: 768px) {
    .contact {
      padding: var(--ds-s16) var(--ds-s12);
    }
  }

  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--ds-s16);
      align-items: start;
    }
  }
</style>
