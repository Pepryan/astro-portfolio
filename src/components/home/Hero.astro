---
/**
 * Homepage hero: statement left, interactive terminal right, on an
 * interactive grid that lights up under the cursor (data-spotlight).
 * Tokens live in src/styles/tokens.css.
 */
import { componentConfig, seoConfig } from '../../config/components';
import { encodeEmail } from '../../lib/email';
import type { BlogPost } from '../../types';
import Terminal from './Terminal.astro';

interface Props {
  /** Latest posts, used by the terminal's `ls`. */
  posts: BlogPost[];
}

const { posts } = Astro.props;
const { hero } = componentConfig;

const socialLabels: Record<string, string> = {
  github: 'GitHub',
  gitlab: 'GitLab',
  linkedin: 'LinkedIn',
  twitter: 'X',
  email: 'Email',
};

const socialLinks = hero.showSocialLinks
  ? hero.socialLinks
      .filter((link) => link.enabled && socialLabels[link.platform])
      .map((link) => ({
        href: link.url,
        label: socialLabels[link.platform],
        external: /^https?:/.test(link.url),
        email: link.platform === 'email' ? encodeEmail(seoConfig.author.email) : undefined,
      }))
  : [];
---

<div class="hero" data-spotlight>
  <div class="hero__bg ds-gridbg" aria-hidden="true"></div>

  <p class="ds-eyebrow hero__eyebrow">
    <span class="ds-marker" aria-hidden="true"></span>
    <span>{hero.title}</span>
    <span class="ds-eyebrow__muted">{hero.role}</span>
  </p>

  <div class="hero__grid">
    <div class="hero__copy">
      <h1 class="hero__title">{hero.headline}</h1>
      <p class="ds-lede hero__lede">{hero.lede}</p>

      <div class="hero__actions">
        <a class="ds-button" href="/blog">
          Read the blog <span class="ds-arrow" aria-hidden="true">→</span>
        </a>

        {socialLinks.length > 0 && (
          <ul class="hero__social" aria-label="Elsewhere">
            {socialLinks.map(({ href, label, external, email }) => (
              <li>
                <a class="ds-link" href={href} data-email={email} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                  {label}
                  {external && <span class="sr-only"> (opens in a new tab)</span>}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <div class="hero__terminal">
      <Terminal posts={posts} />
    </div>
  </div>
</div>

<style>
  .hero {
    --hero-terminal: 32rem;

    position: relative;
    isolation: isolate;
    color: var(--ds-ink);
    font-family: var(--ds-font-text);
    line-height: var(--ds-lh-body);
  }

  /* ---------- Interactive grid (shared .ds-gridbg), bleeding above and below ---------- */
  .hero__bg {
    --gridbg-inset: calc(var(--ds-s24) * -1) 0;
    --gridbg-shift-y: var(--ds-s24);
  }

  /* One-shot scan line on load: a single pass, not a loop */
  @media (prefers-reduced-motion: no-preference) {
    .hero__bg {
      background: linear-gradient(transparent, var(--ds-grid-glow), transparent) no-repeat;
      background-size: 100% var(--ds-s1);
      animation: hero-scan var(--ds-dur-scan) var(--ds-ease) calc(var(--ds-dur) * 2) both;
    }
  }

  /* Moves the line from above the box to below it; never touches opacity,
     which would also hide the grid layers inside .hero__bg */
  @keyframes hero-scan {
    from { background-position-y: calc(0% - var(--ds-s4)); }
    to { background-position-y: calc(100% + var(--ds-s4)); }
  }

  /* ---------- Layout ---------- */
  .hero__eyebrow {
    margin-bottom: var(--ds-s8);
  }

  .hero__grid {
    display: grid;
    gap: var(--ds-s12);
  }

  .hero__copy {
    min-width: 0;
  }

  .hero__title {
    margin: 0;
    font-family: var(--ds-font-display);
    font-size: var(--ds-fs-display);
    font-weight: 700;
    line-height: var(--ds-lh-tight);
    letter-spacing: var(--ds-track-display);
    text-wrap: balance;
  }

  .hero__lede {
    margin-top: var(--ds-s6);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ds-s4) var(--ds-s8);
    margin-top: var(--ds-s8);
  }

  .hero__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--ds-s4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__social .ds-link {
    font-weight: 400;
  }

  .hero__terminal {
    min-width: 0;
    max-width: var(--hero-terminal);
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) var(--hero-terminal);
      align-items: center;
    }
  }
</style>
