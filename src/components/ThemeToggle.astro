---
// Theme switch. Icons are swapped purely with the `dark` class, so there is
// no hydration step and no flash of the wrong state.
import { FiMoon, FiSun } from 'react-icons/fi';
---

<button type="button" data-theme-toggle class="icon-btn group" aria-label="Toggle dark mode" title="Toggle theme (t)">
  <FiSun aria-hidden="true" className="transition-transform duration-300 group-hover:rotate-45 dark:hidden" />
  <FiMoon aria-hidden="true" className="hidden transition-transform duration-300 group-hover:-rotate-12 dark:block" />
</button>

<script>
  import { isDarkMode, onThemeChange, toggleDarkMode } from '../lib/theme';

  const sync = (dark: boolean) => {
    document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
      button.setAttribute('aria-pressed', String(dark));
    });
  };

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', toggleDarkMode);
  });
  sync(isDarkMode());
  onThemeChange(sync);
</script>
