---
import { FiGithub, FiGitlab, FiLinkedin, FiMail, FiRss } from 'react-icons/fi';
import { FaXTwitter } from 'react-icons/fa6';
import { seoConfig } from '../config/components';
import { encodeEmail } from '../lib/email';

const { social, author } = seoConfig;

// Rendered at build time — a static site only needs the year of the last deploy.
const year = new Date().getFullYear();

const links = [
  { href: social.github, label: 'GitHub', icon: FiGithub },
  { href: social.gitlab, label: 'GitLab', icon: FiGitlab },
  { href: social.linkedin, label: 'LinkedIn', icon: FiLinkedin },
  { href: `https://x.com/${social.twitter.username.replace('@', '')}`, label: 'X', icon: FaXTwitter },
  { href: '/contact', label: 'Email', icon: FiMail, email: encodeEmail(author.email) },
  { href: '/rss.xml', label: 'RSS feed', icon: FiRss },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="ds-label site-footer__text">
      © {year} {author.name}
      <span aria-hidden="true">·</span>
      <span>Built with Astro and Claude</span>
    </p>
    <ul class="site-footer__links">
      {links.map(({ href, label, icon: LinkIcon, email }) => (
        <li>
          <a
            class="icon-btn"
            href={href}
            data-email={email}
            aria-label={label}
            title={label}
            {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <LinkIcon aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--ds-hairline) solid var(--ds-rule);
    background: var(--ds-bg);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--ds-s4);
    max-width: var(--ds-container);
    margin-inline: auto;
    padding: var(--ds-s6) var(--ds-s4);
  }

  @media (min-width: 640px) {
    .site-footer__inner {
      padding-inline: var(--ds-s8);
    }
  }

  .site-footer__text {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--ds-s2);
    margin: 0;
  }

  .site-footer__links {
    display: flex;
    gap: var(--ds-s1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
