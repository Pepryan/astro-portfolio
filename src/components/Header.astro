---
/**
 * Site header: full-width bar with a hairline, the ">_" mark and a shell-style
 * prompt that shows where you are (feram@web:~/blog$). Mono nav on wide
 * screens, a small menu below 900px. Nearly opaque instead of backdrop-filter:
 * a blurred backdrop over scrolling content is slow with software compositing.
 */
import { FiMenu, FiSearch } from 'react-icons/fi';
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';
import { componentConfig } from '../config/components';

const { pages, hero } = componentConfig;

const links = [
  { href: '/about', label: 'About', enabled: pages.about.enabled && pages.about.showInNavigation },
  { href: '/projects', label: 'Projects', enabled: pages.projects.enabled && pages.projects.showInNavigation },
  { href: '/blog', label: 'Blog', enabled: true },
  { href: '/series', label: 'Series', enabled: pages.series.enabled && pages.series.showInNavigation },
  { href: '/archive', label: 'Archive', enabled: true },
  { href: '/contact', label: 'Contact', enabled: pages.contact.enabled && pages.contact.showInNavigation },
].filter((link) => link.enabled);

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
const promptPath = pathname === '/' ? '~' : `~${decodeURIComponent(pathname)}`;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label={`${hero.title} — Home`} aria-current={pathname === '/' ? 'page' : undefined}>
      <Logo class="brand__mark" />
      <span class="brand__prompt" aria-hidden="true">
        <span class="brand__who">{hero.terminal.owner}@{hero.terminal.host}:</span><span class="brand__path">{promptPath}</span><span class="brand__dollar">$</span>
      </span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__links">
        {links.map(({ href, label }) => (
          <li>
            <a class="site-nav__link" href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>

      <button type="button" class="icon-btn site-nav__search" data-open-search aria-label="Search articles" title="Search (/ or Ctrl+K)">
        <FiSearch aria-hidden="true" />
        <kbd>/</kbd>
      </button>
      <ThemeToggle />

      <details class="site-menu" data-site-menu>
        <summary class="icon-btn" aria-label="Menu"><FiMenu aria-hidden="true" /></summary>
        <ul class="site-menu__panel">
          {links.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
                <span class="site-menu__path">~{href}</span>
                <span>{label}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  </div>
</header>

<script>
  import { openSearch } from '../lib/search';

  document.querySelectorAll('[data-open-search]').forEach((button) => button.addEventListener('click', openSearch));

  // Close the small-screen menu on outside click or Escape
  const menu = document.querySelector<HTMLDetailsElement>('[data-site-menu]');
  if (menu) {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    height: var(--ds-header);
    border-bottom: var(--ds-hairline) solid var(--ds-rule);
    background: color-mix(in srgb, var(--ds-bg) 94%, transparent);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ds-s4);
    max-width: var(--ds-container);
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--ds-s4);
  }

  @media (min-width: 640px) {
    .site-header__inner {
      padding-inline: var(--ds-s8);
    }
  }

  /* ---------- brand ---------- */
  .brand {
    display: flex;
    align-items: center;
    gap: var(--ds-s3);
    min-width: 0;
    color: var(--ds-ink);
    font-family: var(--ds-font-display);
    font-size: var(--ds-fs-small);
    text-decoration: none;
  }

  .brand :global(.brand__mark) {
    flex-shrink: 0;
    width: var(--ds-s8);
    height: var(--ds-s8);
  }

  /* The caret blinks while you hover the mark — a small "it's alive" */
  .brand:hover :global(.logo__caret),
  .brand:focus-visible :global(.logo__caret) {
    animation: ds-blink 1.1s steps(1) infinite;
  }

  .brand__prompt {
    display: flex;
    min-width: 0;
    white-space: nowrap;
  }

  .brand__who {
    font-weight: 700;
  }

  .brand__path {
    overflow: hidden;
    max-width: 28ch;
    color: var(--ds-accent);
    text-overflow: ellipsis;
  }

  .brand__dollar {
    color: var(--ds-muted);
  }

  @media (max-width: 639px) {
    .brand__who {
      display: none;
    }

    .brand__path {
      max-width: 16ch;
    }
  }

  /* ---------- nav ---------- */
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--ds-s1);
  }

  .site-nav__links {
    display: none;
    align-items: center;
    gap: var(--ds-s1);
    margin: 0 var(--ds-s3) 0 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    position: relative;
    display: block;
    padding: var(--ds-s2) var(--ds-s3);
    color: var(--ds-muted);
    font-family: var(--ds-font-display);
    font-size: var(--ds-fs-label);
    font-weight: 600;
    letter-spacing: var(--ds-track-label);
    text-decoration: none;
    text-transform: uppercase;
    transition: color var(--ds-dur) var(--ds-ease);
  }

  .site-nav__link::after {
    content: '';
    position: absolute;
    inset: auto var(--ds-s3) 0;
    height: 2px;
    background: var(--ds-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--ds-dur) var(--ds-ease);
  }

  .site-nav__link:hover,
  .site-nav__link:focus-visible,
  .site-nav__link[aria-current='page'] {
    color: var(--ds-ink);
  }

  .site-nav__link:hover::after,
  .site-nav__link:focus-visible::after,
  .site-nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-nav__search kbd {
    display: none;
    padding: 0 var(--ds-s1);
    border: var(--ds-hairline) solid var(--ds-rule);
    border-radius: var(--ds-radius);
    color: var(--ds-muted);
    font-family: var(--ds-font-display);
    font-size: var(--ds-fs-label);
    line-height: var(--ds-lh-snug);
  }

  /* ---------- small-screen menu ---------- */
  .site-menu {
    position: relative;
  }

  .site-menu summary {
    list-style: none;
  }

  .site-menu summary::-webkit-details-marker {
    display: none;
  }

  .site-menu[open] summary {
    border-color: var(--ds-rule);
    color: var(--ds-ink);
  }

  .site-menu__panel {
    position: absolute;
    top: calc(100% + var(--ds-s2));
    right: 0;
    min-width: var(--ds-side-col);
    margin: 0;
    padding: var(--ds-s2) 0;
    border: var(--ds-hairline) solid var(--ds-rule);
    border-radius: var(--ds-radius);
    background: var(--ds-bg);
    box-shadow: var(--ds-shadow);
    list-style: none;
  }

  .site-menu__panel a {
    display: flex;
    justify-content: space-between;
    gap: var(--ds-s4);
    padding: var(--ds-s3) var(--ds-s4);
    color: var(--ds-ink);
    font-family: var(--ds-font-display);
    font-size: var(--ds-fs-small);
    text-decoration: none;
  }

  .site-menu__panel a:hover,
  .site-menu__panel a:focus-visible {
    background: var(--ds-wash);
  }

  .site-menu__panel a[aria-current='page'] {
    box-shadow: inset 2px 0 0 var(--ds-accent);
  }

  .site-menu__path {
    color: var(--ds-accent);
  }

  @media (min-width: 900px) {
    .site-nav__links {
      display: flex;
    }

    .site-menu {
      display: none;
    }

    .site-nav__search {
      gap: var(--ds-s2);
      width: auto;
      padding-inline: var(--ds-s2);
    }

    .site-nav__search kbd {
      display: inline-block;
    }
  }
</style>
