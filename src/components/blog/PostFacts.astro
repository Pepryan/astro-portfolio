---
/**
 * Post facts: dates, reading time, series and tags. Rendered twice by
 * PostLayout — inline under the title, and as the sticky left rail on wide
 * screens — and CSS shows exactly one of them.
 */
import type { BlogPost } from '../../types';
import type { SeriesNavigationData } from '../../utils/series';
import { formatDate } from '../../lib/format';
import { tagUrl } from '../../lib/posts';

interface Props {
  data: BlogPost['data'];
  readingTime: number;
  wordCount: number;
  series?: SeriesNavigationData['series'];
  seriesPart: number;
  seriesTotal: number;
  layout: 'inline' | 'rail';
}

const { data, readingTime, wordCount, series, seriesPart, seriesTotal, layout } = Astro.props;
const tags = data.tags ?? [];
---

<div class:list={['facts', `facts--${layout}`]}>
  <dl class="post__meta">
    <div><dt class="ds-label">Published</dt><dd>{formatDate(data.date, 'short')}</dd></div>
    {data.updated && <div><dt class="ds-label">Updated</dt><dd>{formatDate(data.updated, 'short')}</dd></div>}
    <div><dt class="ds-label">Reading</dt><dd>{readingTime} min</dd></div>
    <div><dt class="ds-label">Words</dt><dd>{wordCount.toLocaleString('en-US')}</dd></div>
  </dl>

  {series && (
    <a class="post__series ds-spot" data-spotlight href={`/series/${series.slug}`}>
      <span class="ds-label">Series · Part {seriesPart} of {seriesTotal}</span>
      <span class="post__series-name">{series.name}</span>
      <span class="post__series-bar" style={`--progress: ${(seriesPart / seriesTotal) * 100}%`} aria-hidden="true"></span>
    </a>
  )}

  {tags.length > 0 && (
    <ul class="post__tags" aria-label="Tags">
      {tags.map((tag) => (
        <li><a href={tagUrl(tag)}>#{tag}</a></li>
      ))}
    </ul>
  )}
</div>

<style>
  .facts {
    display: grid;
    gap: var(--ds-s6);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-s4) var(--ds-s8);
    margin: 0;
    padding-block: var(--ds-s4);
    border-block: var(--ds-hairline) solid var(--ds-rule);
  }

  .post__meta dd {
    margin: var(--ds-s1) 0 0;
    font-family: var(--ds-font-display);
    font-weight: 600;
  }

  .post__series {
    display: grid;
    gap: var(--ds-s2);
    padding: var(--ds-s4);
    border: var(--ds-hairline) solid var(--ds-rule);
    border-radius: var(--ds-radius);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--ds-dur) var(--ds-ease);
  }

  .post__series:hover,
  .post__series:focus-visible {
    border-color: var(--ds-accent);
  }

  .post__series .ds-label {
    color: var(--ds-accent);
  }

  .post__series-name {
    font-weight: 600;
  }

  .post__series-bar {
    height: var(--ds-hairline);
    background: linear-gradient(90deg, var(--ds-accent) var(--progress), var(--ds-rule) var(--progress));
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-s2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post__tags a {
    display: inline-block;
    padding: var(--ds-s1) var(--ds-s3);
    border: var(--ds-hairline) solid var(--ds-rule);
    border-radius: var(--ds-radius);
    color: var(--ds-muted);
    font-family: var(--ds-font-display);
    font-size: var(--ds-fs-small);
    text-decoration: none;
    transition:
      color var(--ds-dur) var(--ds-ease),
      border-color var(--ds-dur) var(--ds-ease);
  }

  .post__tags a:hover,
  .post__tags a:focus-visible {
    border-color: var(--ds-ink);
    color: var(--ds-ink);
  }

  /* Rail: everything stacks in one narrow column */
  .facts--rail .post__meta {
    flex-direction: column;
    gap: var(--ds-s4);
  }
</style>
