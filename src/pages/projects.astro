---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/blog/PageHeader.astro';
import GrepFilter from '../components/blog/GrepFilter.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Contact from '../components/home/Contact.astro';
import { generateSEO } from '../utils/seo';
import { componentConfig } from '../config/components';
import { isPageEnabled } from '../utils/pages';
import type { Project } from '../types';

if (!isPageEnabled('projects')) {
  return new Response(null, { status: 404, statusText: 'Page not found' });
}

const { skills, certifications } = componentConfig;

// Newest first; within a year, featured first
const projects = [...(componentConfig.projects.items as Project[])].sort(
  (a, b) => Number(b.year ?? 0) - Number(a.year ?? 0) || Number(Boolean(b.featured)) - Number(Boolean(a.featured))
);
const categories = [...projects.reduce((map, p) => map.set(p.category, (map.get(p.category) ?? 0) + 1), new Map<string, number>())]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const seo = generateSEO({
  title: 'Projects',
  canonical: '/projects',
  description: 'Infrastructure tooling, AI and automation experiments, and web apps by Febryan Ramadhan, plus skills and certifications.',
  type: 'website',
  keywords: ['projects', 'portfolio', 'linux', 'automation', 'ai', 'openstack', 'devops'],
});
---

<Layout title={seo.title} description={seo.description} canonical={seo.canonical} type={seo.type} keywords={seo.keywords}>
  <main class="ds-page">
    <PageHeader
      eyebrow="Projects"
      title="Things I've built"
      lede="Infrastructure tooling, AI and automation experiments, and a few web apps, newest first."
      links={[
        { href: '#skills', text: 'Skills' },
        { href: '#certifications', text: 'Certifications' },
      ]}
    />

    <GrepFilter
      tags={categories}
      noun="projects"
      placeholder="openstack, n8n, laravel…"
      moreLink={null}
      hash={false}
      emptyHint="Try a shorter word or another category."
    />

    <ol class="ds-ledger">
      {projects.map((project, i) => <ProjectRow project={project} number={i + 1} showStatus clamp={false} />)}
    </ol>

    {skills.enabled && (
      <section class="ds-section block" id="skills" aria-labelledby="skills-title">
        <div class="block__head">
          <p class="ds-eyebrow"><span>Skills</span></p>
          <h2 class="ds-h2" id="skills-title">What I know</h2>
          <p class="block__lede">Linux and AI are the daily work; the rest comes from earlier roles and still holds.</p>
        </div>
        <ul class="ds-ledger">
          {skills.categories.map((category) => (
            <li class="skill">
              <h3 class="ds-h3">{category.title}</h3>
              <ul class="skill__items">
                {category.items.map((item) => <li>{item}</li>)}
              </ul>
              <span class:list={['ds-label', 'skill__status', { 'skill__status--now': category.status === 'now' }]}>
                {category.status === 'now' && <span class="ds-marker" aria-hidden="true"></span>}
                {category.status === 'now' ? 'Now' : 'Experience'}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {certifications.length > 0 && (
      <section class="ds-section block" id="certifications" aria-labelledby="certs-title">
        <div class="block__head">
          <p class="ds-eyebrow"><span>Certifications</span></p>
          <h2 class="ds-h2" id="certs-title">On paper, too</h2>
        </div>
        <ul class="ds-ledger">
          {certifications.map((cert) => (
            <li class="cert">
              <span class="ds-label cert__year">{cert.year}</span>
              <div>
                <h3 class="ds-h3">{cert.title}</h3>
                <p class="ds-label cert__issuer">{cert.issuer}{cert.active ? '' : ' · expired'}</p>
              </div>
              {cert.url ? (
                <a class="ds-link" href={cert.url} target="_blank" rel="noopener noreferrer">
                  Credential <span class="ds-arrow" aria-hidden="true">↗</span>
                  <span class="sr-only">: {cert.title} (opens in a new tab)</span>
                </a>
              ) : <span />}
            </li>
          ))}
        </ul>
      </section>
    )}

    <Contact />
  </main>
</Layout>

<style>
  .block {
    display: grid;
    gap: var(--ds-s8);
    padding-bottom: 0;
  }

  .block__head {
    display: grid;
    gap: var(--ds-s4);
  }

  .block__lede {
    max-width: var(--ds-measure);
    margin: 0;
    color: var(--ds-muted);
  }

  @media (min-width: 1024px) {
    .block {
      grid-template-columns: var(--ds-side-col) minmax(0, 1fr);
      gap: var(--ds-s16);
      align-items: start;
    }

    .block__head {
      position: sticky;
      top: var(--ds-s24);
    }
  }

  .skill,
  .cert {
    display: grid;
    gap: var(--ds-s3) var(--ds-s6);
    padding-block: var(--ds-s6);
  }

  .skill {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'title status' 'items items';
  }

  .skill h3 {
    grid-area: title;
  }

  .skill__items {
    grid-area: items;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-s2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill__items li {
    padding: var(--ds-s1) var(--ds-s2);
    border: var(--ds-hairline) solid var(--ds-rule);
    border-radius: var(--ds-radius);
    font-family: var(--ds-font-display);
    font-size: var(--ds-fs-small);
  }

  .skill__status {
    grid-area: status;
    display: inline-flex;
    align-items: center;
    gap: var(--ds-s2);
  }

  .skill__status--now {
    color: var(--ds-ink);
    font-weight: 600;
  }

  .cert {
    grid-template-columns: var(--ds-s16) minmax(0, 1fr);
    align-items: baseline;
  }

  .cert .ds-link {
    grid-column: 2;
    justify-self: start;
    padding: 0;
  }

  .cert__issuer {
    margin: var(--ds-s1) 0 0;
  }

  @media (min-width: 768px) {
    .skill {
      grid-template-columns: var(--ds-side-col) minmax(0, 1fr) auto;
      grid-template-areas: 'title items status';
      align-items: baseline;
    }

    .cert {
      grid-template-columns: var(--ds-s16) minmax(0, 1fr) auto;
    }

    .cert .ds-link {
      grid-column: auto;
    }
  }
</style>
