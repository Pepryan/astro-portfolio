---
import Layout from '../layouts/Layout.astro';
import ArchiveClient from '../components/ArchiveClient';
import { getBlogPosts } from '../lib/posts';
import { generateSEO } from '../utils/seo';

const posts = await getBlogPosts();

const seo = generateSEO({
  title: 'Blog Archive',
  description: `Browse all ${posts.length} blog posts organized by year and category. Find technical articles about cloud engineering, DevOps, infrastructure, and automation.`,
  canonical: '/archive',
  type: 'website',
  keywords: ['archive', 'blog posts', 'articles', 'technical writing', 'history']
});
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  type={seo.type}
  keywords={seo.keywords}
>
  <ArchiveClient posts={posts} client:load />
</Layout>
