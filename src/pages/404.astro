---
import { FiBookOpen, FiEdit3, FiFolder, FiHome } from 'react-icons/fi';
import Layout from '../layouts/Layout.astro';

const links = [
  { href: '/', label: 'Home', hint: 'Back to the homepage', icon: FiHome },
  { href: '/blog', label: 'Blog', hint: 'Latest articles', icon: FiEdit3 },
  { href: '/series', label: 'Series', hint: 'Multi-part guides', icon: FiBookOpen },
  { href: '/projects', label: 'Projects', hint: 'Things I have built', icon: FiFolder },
];
---

<Layout
  title="404 - Page Not Found"
  description="The page you're looking for doesn't exist. Return to the homepage or explore other sections."
  noindex
>
  <main class="mx-auto max-w-4xl px-4 pb-20 pt-36 text-center">
    <p class="font-mono text-sm font-medium text-blue-600 dark:text-blue-400">404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 md:text-5xl">
      Page not found
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-neutral-600 dark:text-neutral-400">
      The page you're looking for doesn't exist. It might have been moved or deleted.
    </p>

    <ul class="mx-auto mt-12 grid max-w-3xl grid-cols-1 gap-4 text-left sm:grid-cols-2">
      {links.map(({ href, label, hint, icon: LinkIcon }) => (
        <li>
          <a
            href={href}
            class="group flex items-center gap-4 rounded-xl border border-neutral-200 p-5 transition-colors
              hover:border-neutral-300 hover:bg-neutral-50 dark:border-neutral-800 dark:hover:border-neutral-700 dark:hover:bg-neutral-800/50"
          >
            <LinkIcon className="h-5 w-5 text-neutral-500 group-hover:text-blue-600 dark:group-hover:text-blue-400" aria-hidden="true" />
            <span>
              <span class="block font-semibold text-neutral-900 dark:text-neutral-100">{label}</span>
              <span class="block text-sm text-neutral-600 dark:text-neutral-400">{hint}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>
