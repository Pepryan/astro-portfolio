---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import Writing from '../components/home/Writing.astro';
import Stack from '../components/home/Stack.astro';
import Work from '../components/home/Work.astro';
import Journey from '../components/home/Journey.astro';
import Contact from '../components/home/Contact.astro';
import { generateSEO } from '../utils/seo';
import { componentConfig } from '../config/components';
import { getBlogPosts } from '../lib/posts';

const { sections } = componentConfig.homepage;

const allPosts = await getBlogPosts();
const latestPosts = allPosts.slice(0, sections.writing.count);

// Number the sections that are actually rendered: 01, 02, …
const order = (['writing', 'stack', 'work', 'journey', 'contact'] as const).filter((key) => sections[key].enabled);
const indexOf = (key: (typeof order)[number]) => String(order.indexOf(key) + 1).padStart(2, '0');

const seo = generateSEO({
  type: 'website',
  canonical: '/',
  keywords: ['portfolio', 'linux sysadmin', 'system administrator', 'ai', 'devops', 'personal website'],
});
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  type={seo.type}
  keywords={seo.keywords}
>
  <main class="mx-auto max-w-7xl px-4 pb-16 sm:px-8">
    <section id="home" class="flex min-h-[100svh] items-center pb-16 pt-28">
      <div class="mx-auto w-full max-w-6xl">
        <Hero postCount={allPosts.length} />
      </div>
    </section>

    {sections.writing.enabled && <div id="writing"><Writing posts={latestPosts} index={indexOf('writing')} /></div>}
    {sections.stack.enabled && <div id="stack"><Stack index={indexOf('stack')} /></div>}
    {sections.work.enabled && <div id="work"><Work index={indexOf('work')} /></div>}
    {sections.journey.enabled && <div id="journey"><Journey index={indexOf('journey')} /></div>}
    {sections.contact.enabled && <div id="contact"><Contact index={indexOf('contact')} /></div>}
  </main>
</Layout>
