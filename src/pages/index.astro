---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import TechStack from '../components/TechStack';
import StoryJourney from '../components/StoryJourney';
import BentoGrid from '../components/BentoGrid';
import FeaturedWork from '../components/FeaturedWork';
import LatestPosts from '../components/LatestPosts';
import CTASection from '../components/CTASection';
import { generateSEO } from '../utils/seo';
import { componentConfig } from '../config/components';
import { shouldShowAboutSection } from '../utils/pages';
import { getBlogPosts } from '../lib/posts';

const { sections } = componentConfig.homepage;

const latestPosts = (await getBlogPosts()).slice(0, 3);

const seo = generateSEO({
  type: 'website',
  canonical: '/',
  keywords: ['portfolio', 'cloud engineer', 'devops specialist', 'personal website']
});
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  type={seo.type}
  keywords={seo.keywords}
>

      <main class="mx-auto mb-10 max-w-7xl px-4 pb-4 pt-20">
        <section id="home" class="-mt-20 flex min-h-screen items-center justify-center px-4">
          <div class="mx-auto w-full max-w-6xl">
            <Hero client:load />
          </div>
        </section>

        <section id="tech" class="relative">
          <TechStack client:only="react" />
        </section>

        {sections.story.enabled && (
          <section id="story" class="relative">
            <StoryJourney client:only="react" />
          </section>
        )}

        {sections.bentoGrid.enabled && shouldShowAboutSection() && (
          <section id="about" class="relative">
            <BentoGrid client:only="react" />
          </section>
        )}

        {sections.featuredWork.enabled && (
          <section id="work" class="relative">
            <FeaturedWork client:only="react" />
          </section>
        )}

        <section id="latest-posts" class="relative">
          <LatestPosts client:only="react" posts={latestPosts} />
        </section>

        {sections.cta.enabled && (
          <section id="contact" class="relative">
            <CTASection client:only="react" />
          </section>
        )}
      </main>

      <!-- Interactive 3D Cube - Floating Easter Egg (hidden on mobile) -->
      <div class="cube-wrapper" title="Click to jump to a random section" aria-hidden="true">
        <div class="cube-container">
          <div class="cube">
            <div style="--x:-1; --y:0;">
              <span style="--i:3;" class="cube-cell"></span>
              <span style="--i:2;" class="cube-cell"></span>
              <span style="--i:1;" class="cube-cell"></span>
            </div>
            <div style="--x:0; --y:0;">
              <span style="--i:3;" class="cube-cell"></span>
              <span style="--i:2;" class="cube-cell"></span>
              <span style="--i:1;" class="cube-cell"></span>
            </div>
            <div style="--x:1; --y:0;">
              <span style="--i:3;" class="cube-cell"></span>
              <span style="--i:2;" class="cube-cell"></span>
              <span style="--i:1;" class="cube-cell"></span>
            </div>
          </div>
          <div class="cube">
            <div style="--x:-1; --y:0;">
              <span style="--i:3;" class="cube-cell"></span>
              <span style="--i:2;" class="cube-cell"></span>
              <span style="--i:1;" class="cube-cell"></span>
            </div>
            <div style="--x:0; --y:0;">
              <span style="--i:3;" class="cube-cell"></span>
              <span style="--i:2;" class="cube-cell"></span>
              <span style="--i:1;" class="cube-cell"></span>
            </div>
            <div style="--x:1; --y:0;">
              <span style="--i:3;" class="cube-cell"></span>
              <span style="--i:2;" class="cube-cell"></span>
              <span style="--i:1;" class="cube-cell"></span>
            </div>
          </div>
          <div class="cube">
            <div style="--x:-1; --y:0;">
              <span style="--i:3;" class="cube-cell"></span>
              <span style="--i:2;" class="cube-cell"></span>
              <span style="--i:1;" class="cube-cell"></span>
            </div>
            <div style="--x:0; --y:0;">
              <span style="--i:3;" class="cube-cell"></span>
              <span style="--i:2;" class="cube-cell"></span>
              <span style="--i:1;" class="cube-cell"></span>
            </div>
            <div style="--x:1; --y:0;">
              <span style="--i:3;" class="cube-cell"></span>
              <span style="--i:2;" class="cube-cell"></span>
              <span style="--i:1;" class="cube-cell"></span>
            </div>
          </div>
        </div>
      </div>
</Layout>

<script>
  // Random Section Jump - Easter Egg Feature
  {
    const sections = ['home', 'tech', 'story', 'about', 'work', 'latest-posts', 'contact'];
    let lastSection = '';

    const cubeCells = document.querySelectorAll('.cube-cell');
    
    cubeCells.forEach(cell => {
      cell.addEventListener('click', (e) => {
        e.stopPropagation();
        
        // Filter out sections that don't exist and the last visited one
        const availableSections = sections.filter(id => {
          const el = document.getElementById(id);
          return el && id !== lastSection;
        });
        
        if (availableSections.length === 0) return;
        
        // Pick random section
        const randomIndex = Math.floor(Math.random() * availableSections.length);
        const targetId = availableSections[randomIndex];
        const targetEl = document.getElementById(targetId);
        
        if (targetEl) {
          lastSection = targetId;
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }
</script>
