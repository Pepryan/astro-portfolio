---
import Layout from '../../layouts/Layout.astro';
import SeriesPageClient from '../../components/SeriesPageClient';
import { getAllSeries } from '../../utils/series';
import { generateSeriesListingSEO } from '../../utils/seo';

// The listing only needs series metadata, not each series' posts
const allSeries = (await getAllSeries()).map(({ posts, ...series }) => series);
const seo = generateSeriesListingSEO(allSeries);
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  type={seo.type}
  keywords={seo.keywords}
>
  <SeriesPageClient series={allSeries} client:load />
</Layout>
