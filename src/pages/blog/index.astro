---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/blog/PageHeader.astro';
import GrepFilter from '../../components/blog/GrepFilter.astro';
import PostLedger from '../../components/blog/PostLedger.astro';
import { getBlogPosts, getTagCounts } from '../../lib/posts';
import { generateBlogListingSEO } from '../../utils/seo';

const posts = await getBlogPosts();
const tags = getTagCounts(posts);
const seo = generateBlogListingSEO(posts);
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  type={seo.type}
  keywords={seo.keywords}
>
  <main class="ds-page">
    <PageHeader
      eyebrow="Blog"
      title="Notes from the terminal"
      lede="Long-form notes on Linux, networking, AI tooling and the infrastructure around them, written while figuring things out."
      links={[
        { href: '/blog/tags', text: 'Tags' },
        { href: '/series', text: 'Series' },
        { href: '/archive', text: 'Archive' },
        { href: '/rss.xml', text: 'RSS' },
      ]}
    />

    <GrepFilter tags={tags} />
    <PostLedger posts={posts} groupByYear />
  </main>
</Layout>
