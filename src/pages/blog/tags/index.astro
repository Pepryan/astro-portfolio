---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/blog/PageHeader.astro';
import { getBlogPosts, getTagCounts, tagUrl } from '../../../lib/posts';
import { generateSEO } from '../../../utils/seo';

const posts = await getBlogPosts();
const tags = getTagCounts(posts);
const max = Math.max(...tags.map(([, count]) => count), 1);

const seo = generateSEO({
  title: 'All Tags',
  description: `Browse ${tags.length} tags across the blog: Linux, networking, AI tooling, Kubernetes and more.`,
  canonical: '/blog/tags',
});
---

<Layout title={seo.title} description={seo.description} canonical={seo.canonical}>
  <main class="ds-page">
    <PageHeader
      eyebrow="Blog"
      eyebrowNote="Tags"
      title="Browse by tag"
      lede="Every topic I've written about, most used first."
      links={[
        { href: '/blog', text: 'All posts' },
        { href: '/series', text: 'Series' },
        { href: '/archive', text: 'Archive' },
      ]}
    />

    <table class="tags">
      <caption class="sr-only">Tags and how many posts use each one</caption>
      <thead>
        <tr>
          <th scope="col" class="ds-label">Tag</th>
          <th scope="col" class="ds-label tags__num">Posts</th>
          <th scope="col" class="tags__bar-col"><span class="sr-only">Share of posts</span></th>
        </tr>
      </thead>
      <tbody>
        {tags.map(([tag, count]) => (
          <tr class="ds-spot" data-spotlight>
            <th scope="row">
              <a class="tags__link" href={tagUrl(tag)}>#{tag}</a>
            </th>
            <td class="tags__num">{count}</td>
            <td class="tags__bar-col" aria-hidden="true">
              <span class="tags__bar" style={`--share: ${(count / max) * 100}%`}></span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </main>
</Layout>

<style>
  .tags {
    width: 100%;
    border-collapse: collapse;
    border-top: var(--ds-hairline) solid var(--ds-ink);
    font-family: var(--ds-font-display);
    text-align: left;
  }

  .tags thead th {
    padding-block: var(--ds-s3);
    font-weight: 400;
  }

  .tags tbody :is(th, td) {
    padding: var(--ds-s3) var(--ds-s4) var(--ds-s3) 0;
    border-bottom: var(--ds-hairline) solid var(--ds-rule);
  }

  .tags__link {
    color: var(--ds-ink);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--ds-dur) var(--ds-ease);
  }

  .tags__link:hover,
  .tags__link:focus-visible {
    color: var(--ds-accent);
  }

  /* Make the whole row clickable without nesting links */
  .tags tbody tr {
    position: relative;
  }

  .tags__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .tags__num {
    width: var(--ds-s16);
    color: var(--ds-muted);
    text-align: right;
  }

  .tags__bar-col {
    width: 50%;
  }

  .tags__bar {
    display: block;
    width: var(--share);
    height: var(--ds-s1);
    background: var(--ds-accent);
  }

  @media (max-width: 639px) {
    .tags__bar-col {
      width: 30%;
    }
  }
</style>
