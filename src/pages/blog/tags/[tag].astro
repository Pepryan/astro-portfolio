---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/blog/PageHeader.astro';
import PostLedger from '../../../components/blog/PostLedger.astro';
import { getBlogPosts } from '../../../lib/posts';
import { generateTagPageSEO } from '../../../utils/seo';

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags?.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
const seo = generateTagPageSEO(tag, posts);
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  type={seo.type}
  keywords={seo.keywords}
>
  <main class="ds-page">
    <PageHeader
      eyebrow="Tag"
      eyebrowNote={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`}
      title={`#${tag}`}
      links={[
        { href: '/blog/tags', text: 'All tags' },
        { href: '/blog', text: 'All posts' },
      ]}
    />
    <PostLedger posts={posts} />
  </main>
</Layout>
