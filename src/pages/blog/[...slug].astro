---
import Layout from '../../layouts/Layout.astro';
import PostLayout from '../../components/blog/PostLayout.astro';
import { getCollection, render } from 'astro:content';
import { getPublishedPosts, getReadingStats, toBlogPost, type PostEntry } from '../../lib/posts';
import { generateBlogPostSEO } from '../../utils/seo';
import { getSeriesNavigation } from '../../utils/series';

export async function getStaticPaths() {
  // Drafts are never built; `hidden` posts are built (reachable by URL) but not listed.
  const posts = await getCollection('posts', (post) => !post.data.draft);
  const allPosts = (await getPublishedPosts()).map(toBlogPost);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts },
  }));
}

interface Props {
  post: PostEntry;
  allPosts: ReturnType<typeof toBlogPost>[];
}

const { post, allPosts } = Astro.props;
const slug = post.id;
const { Content, headings } = await render(post);
const { minutes: readingTime, words } = getReadingStats(post);
const seriesNavigation = await getSeriesNavigation({ slug, data: post.data });

const seo = generateBlogPostSEO({ ...post.data, slug });
---

<Layout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  canonical={seo.canonical}
  type={seo.type}
  publishedTime={seo.publishedTime}
  modifiedTime={seo.modifiedTime}
  keywords={seo.keywords}
  tags={seo.tags}
  section={seo.section}
>
  <PostLayout
    post={{ slug, data: post.data }}
    headings={headings}
    readingTime={readingTime}
    wordCount={words}
    allPosts={allPosts}
    seriesNavigation={seriesNavigation}
  >
    <Content />
  </PostLayout>
</Layout>
