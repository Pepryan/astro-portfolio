---
import Layout from '../../layouts/Layout.astro';
import BlogPostLayout from '../../components/BlogPostLayout';
import { getCollection } from 'astro:content';
import { getPublishedPosts, getReadingStats, toBlogPost, type PostEntry } from '../../lib/posts';
import { generateBlogPostSEO } from '../../utils/seo';
import { getSeriesNavigation } from '../../utils/series';

export async function getStaticPaths() {
  // Drafts are never built; `hidden` posts are built (reachable by URL) but not listed.
  const posts = await getCollection('posts', (post) => !post.data.draft);
  const allPosts = (await getPublishedPosts()).map(toBlogPost);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts },
  }));
}

interface Props {
  post: PostEntry;
  allPosts: ReturnType<typeof toBlogPost>[];
}

const { post, allPosts } = Astro.props;
const { Content } = await post.render();
const { minutes: readingTime, words } = getReadingStats(post);
const seriesNavigation = await getSeriesNavigation(post);

const seo = generateBlogPostSEO({ ...post.data, slug: post.slug });
---

<Layout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  canonical={seo.canonical}
  type={seo.type}
  publishedTime={seo.publishedTime}
  modifiedTime={seo.modifiedTime}
  keywords={seo.keywords}
  tags={seo.tags}
  section={seo.section}
>
  <BlogPostLayout
    post={{ slug: post.slug, data: post.data }}
    readingTime={readingTime}
    wordCount={words}
    allPosts={allPosts}
    seriesNavigation={seriesNavigation}
    client:load
  >
    <Content />
  </BlogPostLayout>
</Layout>
