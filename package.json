{
  "name": "febryan-portfolio-astro",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "homepage": "https://febryan.web.id",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
