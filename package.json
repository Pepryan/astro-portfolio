    "deploy": "npm run build && touch dist/.nojekyll && gh-pages -d dist --dotfiles",
    "validate-sitemap": "node scripts/validate-sitemap.js",
    "build:validate": "npm run build && npm run validate-sitemap",
    "compress-images": "node scripts/compress-images.js",
    "favicons": "node scripts/generate-favicons.js",
    "check": "astro check",
    "trek:add": "node scripts/add-trek.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.7.0",
    "rehype-pretty-code": "^0.14.6",
    "satori": "^0.63.2",
    "shiki": "^4.6.0",
