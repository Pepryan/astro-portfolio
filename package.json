    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.6.2",
    "gh-pages": "^6.2.0",
    "pagefind": "^1.6.0",
    "sharp": "^0.35.5",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "allowScripts": {
    "esbuild@0.25.5": true,
    "sharp@0.33.5": true
  },
  "overrides": {
    "fflate": "^0.8.3",
    "postcss-selector-parser": "^6.1.5"
